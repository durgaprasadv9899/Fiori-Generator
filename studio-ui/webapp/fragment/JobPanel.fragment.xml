<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <!-- Inline progress of a background job; the parent sets the binding context to jobs>/byKind/<kind> -->
    <HBox visible="{= !!${jobs>status} }" class="evJobPanel sapUiSmallMarginTop" alignItems="Start">
        <BusyIndicator size="1.5rem" class="sapUiSmallMarginEnd"/>
        <VBox>
            <Text text="{= ${jobs>label} + ' - ' + Math.round(${jobs>seconds} || 0) + 's' }" class="evStrong"/>
            <Text text="Runs in the background - you can switch steps or pages; the result appears when it is ready."
                  class="evMuted evSmall"/>
            <Text text="{path: 'jobs>messages', formatter: '.fmt.lastMessages'}" class="evJobMsg" maxLines="4"/>
        </VBox>
    </HBox>
</core:FragmentDefinition>
