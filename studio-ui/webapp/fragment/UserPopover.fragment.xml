<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <ResponsivePopover id="userPopover" title="{me>/user/name}" placement="Bottom" contentWidth="22rem">
        <VBox class="sapUiSmallMargin">
            <Label text="User"/>
            <Text text="{me>/user/id}"/>
            <Label text="Roles" class="sapUiSmallMarginTop"/>
            <Text text="{path: 'me>/user/roles', formatter: '.fmt.roles'}"/>
            <Label text="Signed in with" class="sapUiSmallMarginTop"/>
            <Text text="{= ${me>/user/source} === 'xsuaa' ? 'SAP BTP login' : ${me>/user/source} }"/>
            <Label text="Workspace" class="sapUiSmallMarginTop"/>
            <Text text="{= ${me>/store/kind} === 'hana' ? 'SAP HANA Cloud (persistent)' : 'Local storage' }"/>
            <MessageStrip text="{me>/store/note}" type="Warning" visible="{= !!${me>/store/note} }"
                          class="sapUiSmallMarginTop"/>
        </VBox>
    </ResponsivePopover>
</core:FragmentDefinition>
