<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <ResponsivePopover id="jobsPopover" title="{i18n>jobsRunning}" placement="Bottom" contentWidth="26rem">
        <List items="{jobs>/list}" noDataText="{i18n>jobsNone}">
            <CustomListItem>
                <VBox class="sapUiSmallMargin">
                    <HBox alignItems="Center" justifyContent="SpaceBetween">
                        <HBox alignItems="Center">
                            <BusyIndicator size="1rem" class="sapUiTinyMarginEnd"/>
                            <Text text="{jobs>label}" class="evStrong"/>
                        </HBox>
                        <ObjectNumber number="{path: 'jobs>seconds', formatter: '.fmt.seconds'}"/>
                    </HBox>
                    <Text text="{path: 'jobs>messages', formatter: '.fmt.lastMessages'}" class="evJobMsg" maxLines="4"/>
                </VBox>
            </CustomListItem>
        </List>
        <footer>
            <Toolbar>
                <Text text="Jobs keep running while you navigate." class="sapUiTinyMarginBegin evMuted"/>
            </Toolbar>
        </footer>
    </ResponsivePopover>
</core:FragmentDefinition>
