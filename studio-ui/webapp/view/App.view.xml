<mvc:View controllerName="com.evoke.studio.controller.App"
    xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:tnt="sap.tnt" xmlns:core="sap.ui.core"
    displayBlock="true" height="100%">
    <tnt:ToolPage id="toolPage" sideExpanded="{= !${device>/isPhone} }">
        <tnt:header>
            <tnt:ToolHeader id="toolHeader" class="evHeader">
                <Button id="sideToggle" icon="sap-icon://menu2" type="Transparent" press=".onSideToggle"
                        tooltip="Toggle navigation">
                    <layoutData><OverflowToolbarLayoutData priority="NeverOverflow"/></layoutData>
                </Button>
                <Image src="img/evoke_logo.png" height="1.75rem" alt="Evoke" class="evLogo"/>
                <Title text="{i18n>appTitle}" level="H1" wrapping="false" class="evAppTitle">
                    <layoutData><OverflowToolbarLayoutData priority="Disappear"/></layoutData>
                </Title>
                <ToolbarSpacer/>
                <ObjectStatus id="aiStatus" class="evAiStatus" inverted="true"
                    icon="sap-icon://lightbulb"
                    text="{= ${me>/ai/available} ? ${me>/ai/model} : 'No AI model - rule-based design' }"
                    state="{= ${me>/ai/available} ? 'Success' : 'Warning' }">
                    <layoutData><OverflowToolbarLayoutData priority="Low"/></layoutData>
                </ObjectStatus>
                <Button id="jobsButton" icon="sap-icon://process" type="Emphasized"
                        text="{= ${jobs>/count} + ' running' }" visible="{= ${jobs>/count} > 0 }"
                        press=".onJobsPress" tooltip="{i18n>jobsRunning}">
                    <layoutData><OverflowToolbarLayoutData priority="NeverOverflow"/></layoutData>
                </Button>
                <Avatar id="userAvatar" initials="{path: 'me>/user/name', formatter: '.fmt.initials'}"
                        displaySize="XS" backgroundColor="Accent6" press=".onUserPress"
                        tooltip="{me>/user/name}"/>
            </tnt:ToolHeader>
        </tnt:header>
        <tnt:sideContent>
            <tnt:SideNavigation id="sideNav" itemSelect=".onNavSelect" selectedKey="{view>/navKey}">
                <tnt:NavigationList>
                    <tnt:NavigationListItem key="projects" text="{i18n>navProjects}" icon="sap-icon://folder-blank"/>
                    <tnt:NavigationListItem key="studio" text="{i18n>navNewApp}" icon="sap-icon://add-document"/>
                </tnt:NavigationList>
                <tnt:fixedItem>
                    <tnt:NavigationList>
                        <tnt:NavigationListItem key="store" selectable="false"
                            text="{= ${me>/store/kind} === 'hana' ? 'Workspace: SAP HANA Cloud' : 'Workspace: local storage' }"
                            icon="sap-icon://database"/>
                    </tnt:NavigationList>
                </tnt:fixedItem>
            </tnt:SideNavigation>
        </tnt:sideContent>
        <tnt:mainContents>
            <App id="pages" class="evPages"/>
        </tnt:mainContents>
    </tnt:ToolPage>
</mvc:View>
