<mvc:View controllerName="com.evoke.studio.controller.Studio"
    xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout" height="100%">
    <f:DynamicPage id="studioPage" headerExpanded="true" showFooter="true" fitContent="false">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{= ${draft>/domain/title} || ${i18n>navNewApp} }" level="H2" wrapping="true"/>
                </f:heading>
                <f:expandedContent>
                    <Text text="{= ${draft>/projectId} ? 'Saved in the workspace - every generation is a new version.' : 'Not generated yet - the first generation creates a project in the workspace.' }"
                          class="evMuted"/>
                </f:expandedContent>
                <f:actions>
                    <Button text="{i18n>startNew}" icon="sap-icon://add-document" type="Transparent" press=".onStartNew"/>
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>
        <f:content>
            <IconTabBar id="steps" selectedKey="{draft>/step}" select=".onStepSelect" expandable="false"
                        headerMode="Inline" stretchContentHeight="false" applyContentPadding="true"
                        class="evSteps" tabDensityMode="Compact">
                <items>
                    <!-- ═════════ 1 Describe ═════════ -->
                    <IconTabFilter key="describe" icon="sap-icon://edit" text="{i18n>stepDescribe}"
                                   iconColor="{= ${draft>/domain} ? 'Positive' : 'Default' }">
                        <VBox class="evStep">
                            <Title text="{i18n>describeTitle}" level="H3"/>
                            <Text text="{i18n>describeText}" class="evMuted sapUiTinyMarginTop sapUiSmallMarginBottom"/>
                            <Label text="{i18n>examples}"/>
                            <HBox items="{app>/examples}" wrap="Wrap" class="sapUiTinyMarginBottom">
                                <Button text="{app>title}" press=".onExample" type="Ghost" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"/>
                            </HBox>
                            <TextArea id="requirement" value="{draft>/requirement}" width="100%" rows="6" growing="true"
                                      growingMaxLines="16" placeholder="{i18n>requirementPlaceholder}"
                                      valueLiveUpdate="true"/>
                            <HBox class="sapUiSmallMarginTop" wrap="Wrap">
                                <Button id="btnQuestions" text="{i18n>checkRequirement}" icon="sap-icon://question-mark"
                                        press=".onQuestions" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
                                        enabled="{= !!${draft>/requirement} &amp;&amp; ${me>/ai/available} === true &amp;&amp; !${jobs>/byKind/questions} }"
                                        tooltip="The AI asks questions when roles, approval levels or data are unclear (needs an AI model)."/>
                                <Button id="btnDomain" text="{i18n>designModel}" icon="sap-icon://database" type="Emphasized"
                                        press=".onDesignDomain" class="sapUiTinyMarginBottom"
                                        enabled="{= !!${draft>/requirement} &amp;&amp; !${jobs>/byKind/domain} }"/>
                            </HBox>
                            <VBox binding="{jobs>/byKind/questions}">
                                <core:Fragment fragmentName="com.evoke.studio.fragment.JobPanel" type="XML"/>
                            </VBox>
                            <VBox binding="{jobs>/byKind/domain}">
                                <core:Fragment fragmentName="com.evoke.studio.fragment.JobPanel" type="XML"/>
                            </VBox>
                            <VBox visible="{= ${draft>/questions}.length > 0 }" class="sapUiSmallMarginTop">
                                <Panel headerText="{i18n>questionsTitle}" class="evCard">
                                    <List items="{draft>/questions}" showSeparators="Inner" backgroundDesign="Transparent">
                                        <CustomListItem>
                                            <VBox class="sapUiSmallMarginTopBottom">
                                                <Label text="{draft>question}" wrapping="true" design="Bold"/>
                                                <ComboBox value="{draft>answer}" items="{path: 'draft>options', templateShareable: false}"
                                                          width="100%" placeholder="Let the AI decide, pick an option or type an answer">
                                                    <core:Item text="{draft>text}" key="{draft>text}"/>
                                                </ComboBox>
                                                <Text text="{draft>why}" class="evMuted evSmall" visible="{= !!${draft>why} }"/>
                                            </VBox>
                                        </CustomListItem>
                                    </List>
                                </Panel>
                            </VBox>
                        </VBox>
                    </IconTabFilter>
                    <IconTabSeparator icon="sap-icon://process"/>

                    <!-- ═════════ 2 Data model ═════════ -->
                    <IconTabFilter key="model" icon="sap-icon://database" text="{i18n>stepModel}"
                                   enabled="{= !!${draft>/domain} }" iconColor="{= ${draft>/domain} ? 'Positive' : 'Default' }">
                        <VBox class="evStep">
                            <IllustratedMessage visible="{= !${draft>/domain} }" illustrationType="sapIllus-NoEntries"
                                                title="{i18n>modelEmpty}" enableVerticalResponsiveness="true"/>
                            <VBox visible="{= !!${draft>/domain} }">
                                <HBox justifyContent="SpaceBetween" alignItems="Start" wrap="Wrap">
                                    <VBox class="sapUiSmallMarginEnd">
                                        <Title text="{draft>/domain/title}" level="H3"/>
                                        <Text text="{draft>/domain/description}" class="evMuted" maxLines="3"/>
                                    </VBox>
                                    <ObjectStatus text="{= ${draft>/domainSource} === 'ai' ? 'Designed by AI' : ${draft>/domainSource} === 'rules' ? 'Rule-based template' : ${draft>/domainSource} === 'saved' ? 'From a saved version' : 'Edited' }"
                                                  state="{= ${draft>/domainSource} === 'ai' ? 'Success' : 'Information' }"
                                                  inverted="true"/>
                                </HBox>
                                <VBox items="{draft>/domainNotes}" class="sapUiSmallMarginTop">
                                    <MessageStrip text="{draft>}" type="Information" showIcon="true" class="sapUiTinyMarginBottom"/>
                                </VBox>
                                <layout:Grid defaultSpan="XL6 L6 M12 S12" class="sapUiSmallMarginTop" hSpacing="1"
                                             content="{draft>/domain/entities}">
                                    <Panel headerText="{= ${draft>label} + '  (' + ${draft>name} + ')' + (${draft>parent} ? ' - items of ' + ${draft>parent} : '') }"
                                           expandable="true" expanded="true" class="evCard">
                                        <Table items="{path: 'draft>fields', templateShareable: false}" class="evInner">
                                            <columns>
                                                <Column><Text text="Field"/></Column>
                                                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="Name"/></Column>
                                                <Column><Text text="Type"/></Column>
                                                <Column hAlign="Center" width="5rem"><Text text="Required"/></Column>
                                                <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="WithoutHeader"><Text text=""/></Column>
                                            </columns>
                                            <items>
                                                <ColumnListItem>
                                                    <cells>
                                                        <Text text="{draft>label}"/>
                                                        <Text text="{draft>name}" class="evMono" wrapping="false"/>
                                                        <Text text="{parts: ['draft>type', 'draft>length', 'draft>precision', 'draft>scale'], formatter: '.fmt.fieldType'}" wrapping="false"/>
                                                        <core:Icon src="sap-icon://accept" visible="{= !!${draft>required} }"/>
                                                        <ObjectStatus text="{path: 'draft>formula', formatter: '.fmt.calc'}" state="Information"/>
                                                    </cells>
                                                </ColumnListItem>
                                            </items>
                                        </Table>
                                    </Panel>
                                </layout:Grid>
                                <Panel headerText="{= ${i18n>workflow} + ' - ' + ${draft>/domain/workflow/entity} + ' (' + ${draft>/domain/workflow/status_field} + ')' }"
                                       visible="{= !!${draft>/domain/workflow} }" class="evCard sapUiSmallMarginTop">
                                    <HBox items="{draft>/domain/workflow/states}" wrap="Wrap" class="sapUiSmallMarginBottom">
                                        <ObjectStatus text="{draft>label}" state="{path: 'draft>criticality', formatter: '.fmt.criticality'}"
                                                      inverted="true" class="sapUiSmallMarginEnd sapUiTinyMarginBottom"/>
                                    </HBox>
                                    <Table items="{draft>/domain/workflow/transitions}">
                                        <columns>
                                            <Column><Text text="Action"/></Column>
                                            <Column><Text text="From"/></Column>
                                            <Column><Text text="To"/></Column>
                                            <Column minScreenWidth="Tablet" demandPopin="true"><Text text="Role"/></Column>
                                            <Column minScreenWidth="Tablet" demandPopin="true"><Text text="Comment"/></Column>
                                        </columns>
                                        <items>
                                            <ColumnListItem>
                                                <cells>
                                                    <ObjectIdentifier title="{draft>label}" text="{draft>action}"/>
                                                    <Text text="{path: 'draft>from', formatter: '.fmt.join'}"/>
                                                    <Text text="{draft>to}"/>
                                                    <Text text="{= ${draft>role} || 'any signed-in user' }"/>
                                                    <Text text="{draft>comment}"/>
                                                </cells>
                                            </ColumnListItem>
                                        </items>
                                    </Table>
                                </Panel>
                                <Panel headerText="{i18n>database}" class="evCard sapUiSmallMarginTop">
                                    <SegmentedButton selectedKey="{draft>/db}" selectionChange=".onDbChange">
                                        <items>
                                            <SegmentedButtonItem key="sqlite" text="{i18n>dbSqlite}" icon="sap-icon://it-system"/>
                                            <SegmentedButtonItem key="hana" text="{i18n>dbHana}" icon="sap-icon://database"/>
                                        </items>
                                    </SegmentedButton>
                                    <MessageStrip text="{= ${draft>/db} === 'hana' ? ${i18n>dbHanaText} : ${i18n>dbSqliteText} }"
                                                  type="{= ${draft>/db} === 'hana' ? 'Warning' : 'Information' }" showIcon="true"
                                                  class="sapUiSmallMarginTop"/>
                                </Panel>
                                <Panel headerText="{i18n>expertJson}" expandable="true" expanded="false"
                                       class="evCard sapUiSmallMarginTop">
                                    <TextArea value="{draft>/domainJson}" width="100%" rows="18" class="evCode"/>
                                    <Button id="btnApplyJson" text="{i18n>applyJson}" press=".onApplyJson" class="sapUiTinyMarginTop"/>
                                </Panel>
                            </VBox>
                        </VBox>
                    </IconTabFilter>
                    <IconTabSeparator icon="sap-icon://process"/>

                    <!-- ═════════ 3 Screens ═════════ -->
                    <IconTabFilter key="design" icon="sap-icon://palette" text="{i18n>stepDesign}"
                                   enabled="{= !!${draft>/domain} }" iconColor="{= ${draft>/design} ? 'Positive' : 'Default' }">
                        <VBox class="evStep">
                            <Title text="{i18n>designTitle}" level="H3"/>
                            <Text text="The AI designs the pages, columns, filters, actions, calculations and rules on top of the generated service. Add screen wishes to the requirement in step 1."
                                  class="evMuted sapUiTinyMarginTop sapUiSmallMarginBottom"/>
                            <HBox alignItems="End" wrap="Wrap">
                                <VBox class="sapUiSmallMarginEnd sapUiTinyMarginBottom">
                                    <Label text="{i18n>floorplan}" labelFor="floorplan"/>
                                    <Select id="floorplan" selectedKey="{draft>/floorplan}" width="22rem">
                                        <core:Item key="" text="Let the AI decide (recommended)"/>
                                        <core:Item key="FreestyleApp" text="Custom multi-page app"/>
                                        <core:Item key="ListReportObjectPage" text="List Report + Object Page (Fiori Elements)"/>
                                        <core:Item key="Worklist" text="Worklist (Fiori Elements)"/>
                                        <core:Item key="AnalyticalListPage" text="Analytical List Page"/>
                                        <core:Item key="OverviewPage" text="Overview Page"/>
                                        <core:Item key="FreestyleListDetail" text="Freestyle list + object page"/>
                                        <core:Item key="FreestyleMasterDetail" text="Freestyle master-detail"/>
                                        <core:Item key="FreestyleWorklist" text="Freestyle worklist"/>
                                    </Select>
                                </VBox>
                                <Button id="btnDesign" text="{i18n>designScreens}" icon="sap-icon://palette" type="Emphasized"
                                        press=".onDesign" class="sapUiTinyMarginBottom"
                                        enabled="{= !!${draft>/domain} &amp;&amp; !${jobs>/byKind/design} }"/>
                            </HBox>
                            <VBox binding="{jobs>/byKind/design}">
                                <core:Fragment fragmentName="com.evoke.studio.fragment.JobPanel" type="XML"/>
                            </VBox>
                            <VBox visible="{= !!${draft>/design} }" class="sapUiSmallMarginTop">
                                <HBox wrap="Wrap" class="sapUiSmallMarginBottom">
                                    <VBox class="evKpi">
                                        <Label text="{i18n>coverage}"/>
                                        <ObjectNumber number="{path: 'draft>/design/coverage_score', formatter: '.fmt.score'}"
                                                      state="{path: 'draft>/design/coverage_score', formatter: '.fmt.scoreState'}"
                                                      class="evKpiNumber"/>
                                    </VBox>
                                    <VBox class="evKpi">
                                        <Label text="Floorplan"/>
                                        <Text text="{draft>/design/blueprint/floorplan}" class="evKpiText"/>
                                    </VBox>
                                    <VBox class="evKpi">
                                        <Label text="Pages"/>
                                        <Text text="{path: 'draft>/design/blueprint/pages', formatter: '.fmt.pageCount'}" class="evKpiText"/>
                                    </VBox>
                                    <VBox class="evKpi">
                                        <Label text="Service"/>
                                        <Text text="{draft>/design/service_url}" class="evKpiText evMono"/>
                                    </VBox>
                                </HBox>
                                <Text text="{draft>/design/blueprint/reasoning}" class="evMuted sapUiSmallMarginBottom"
                                      visible="{= !!${draft>/design/blueprint/reasoning} }"/>
                                <Table items="{draft>/design/coverage}" visible="{path: 'draft>/design/coverage', formatter: '.fmt.nonEmpty'}"
                                       class="sapUiSmallMarginBottom">
                                    <headerToolbar><OverflowToolbar><Title text="{i18n>coverage}" level="H4"/></OverflowToolbar></headerToolbar>
                                    <columns>
                                        <Column width="45%"><Text text="Feature"/></Column>
                                        <Column width="8rem"><Text text="Status"/></Column>
                                        <Column minScreenWidth="Tablet" demandPopin="true"><Text text="How"/></Column>
                                    </columns>
                                    <items>
                                        <ColumnListItem>
                                            <cells>
                                                <Text text="{draft>feature}"/>
                                                <ObjectStatus text="{path: 'draft>status', formatter: '.fmt.statusText'}"
                                                              state="{path: 'draft>status', formatter: '.fmt.statusState'}"/>
                                                <Text text="{draft>detail}" class="evMuted"/>
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                                <Panel headerText="{parts: ['i18n>notes', 'draft>/design/notes'], formatter: '.fmt.titleCount'}"
                                       expandable="true" expanded="false" class="evCard"
                                       visible="{path: 'draft>/design/notes', formatter: '.fmt.nonEmpty'}">
                                    <List items="{draft>/design/notes}" showSeparators="Inner">
                                        <StandardListItem title="{draft>}" wrapping="true" icon="sap-icon://hint"/>
                                    </List>
                                </Panel>
                                <Panel headerText="{i18n>structure}" expandable="true" expanded="false"
                                       class="evCard sapUiSmallMarginTop" visible="{= !!${draft>/design/structure} }">
                                    <Text text="{draft>/design/structure}" renderWhitespace="true" class="evCode"/>
                                </Panel>
                            </VBox>
                        </VBox>
                    </IconTabFilter>
                    <IconTabSeparator icon="sap-icon://process"/>

                    <!-- ═════════ 4 Try it ═════════ -->
                    <IconTabFilter key="preview" icon="sap-icon://show" text="{i18n>stepPreview}"
                                   enabled="{= !!${draft>/design} }">
                        <VBox class="evStep">
                            <HBox justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap">
                                <Title text="{i18n>previewTitle}" level="H3"/>
                                <Button id="btnPreview" text="{i18n>refreshPreview}" icon="sap-icon://refresh" press=".onPreview"/>
                            </HBox>
                            <MessageStrip text="{i18n>previewStrip}" type="Warning" showIcon="true"
                                          class="sapUiSmallMarginTopBottom"/>
                            <core:HTML id="previewHost" preferDOM="true"
                                       content="&lt;div class=&quot;evPreviewHost&quot;&gt;&lt;iframe id=&quot;evPreviewFrame&quot; class=&quot;evPreview&quot; title=&quot;App preview&quot;&gt;&lt;/iframe&gt;&lt;/div&gt;"/>
                        </VBox>
                    </IconTabFilter>
                    <IconTabSeparator icon="sap-icon://process"/>

                    <!-- ═════════ 5 Generate & validate ═════════ -->
                    <IconTabFilter key="generate" icon="sap-icon://product" text="{i18n>stepGenerate}"
                                   enabled="{= !!${draft>/design} }" iconColor="{= ${draft>/generated} ? 'Positive' : 'Default' }">
                        <VBox class="evStep">
                            <Title text="{i18n>generateTitle}" level="H3"/>
                            <Text text="Generates the CAP backend (data model, service, workflow, sample data), the SAPUI5 app, the approuter, XSUAA and the MTA deployment descriptor, and saves them as a new project version."
                                  class="evMuted sapUiTinyMarginTop sapUiSmallMarginBottom"/>
                            <HBox alignItems="End" wrap="Wrap">
                                <VBox class="sapUiSmallMarginEnd sapUiTinyMarginBottom">
                                    <Label text="{i18n>appId}" labelFor="appId" required="true"/>
                                    <Input id="appId" value="{draft>/appId}" width="22rem" valueLiveUpdate="true"
                                           valueState="{path: 'draft>/appId', formatter: '.fmt.appIdState'}"
                                           valueStateText="Use a dotted namespace like com.evoke.purchaserequests"/>
                                </VBox>
                                <Button id="btnGenerate" text="{i18n>generate}" icon="sap-icon://process" type="Emphasized"
                                        press=".onGenerate" class="sapUiTinyMarginBottom"
                                        enabled="{parts: ['draft>/design', 'jobs>/byKind/generate', 'draft>/appId'], formatter: '.fmt.canGenerate'}"/>
                            </HBox>
                            <VBox binding="{jobs>/byKind/generate}">
                                <core:Fragment fragmentName="com.evoke.studio.fragment.JobPanel" type="XML"/>
                            </VBox>

                            <VBox visible="{= !!${draft>/generated} }" class="sapUiSmallMarginTop">
                                <HBox wrap="Wrap" class="sapUiSmallMarginBottom" alignItems="Center">
                                    <VBox class="evKpi">
                                        <Label text="Version"/>
                                        <Text text="{= 'v' + ${draft>/generated/version_number} }" class="evKpiText"/>
                                    </VBox>
                                    <VBox class="evKpi">
                                        <Label text="Files"/>
                                        <Text text="{draft>/generated/file_count}" class="evKpiText"/>
                                    </VBox>
                                    <VBox class="evKpi" visible="{= !!${draft>/generated/quality} }">
                                        <Label text="Quality gate"/>
                                        <ObjectStatus text="{path: 'draft>/generated/quality', formatter: '.fmt.qualityText'}"
                                                      state="{path: 'draft>/generated/quality', formatter: '.fmt.qualityState'}"
                                                      class="evKpiText"/>
                                    </VBox>
                                    <Button text="{i18n>downloadZip}" icon="sap-icon://download" press=".onDownload"
                                            class="sapUiSmallMarginEnd"/>
                                    <Button text="Open project" icon="sap-icon://folder-blank" press=".onOpenProject"/>
                                </HBox>
                                <VBox items="{draft>/generated/notes}">
                                    <MessageStrip text="{draft>}" type="Information" showIcon="true" class="sapUiTinyMarginBottom"/>
                                </VBox>
                                <Panel headerText="{= 'Files (' + ${draft>/generated/file_count} + ')' }" expandable="true"
                                       expanded="false" class="evCard">
                                    <List items="{draft>/generated/files}" growing="true" growingThreshold="60">
                                        <StandardListItem title="{draft>}" icon="sap-icon://document-text"/>
                                    </List>
                                </Panel>

                                <!-- validation -->
                                <Panel headerText="{i18n>validationTitle}" class="evCard sapUiSmallMarginTop">
                                    <Text text="Builds and runs the project in a sandbox: JavaScript syntax, UI5 build, MTA and approuter wiring, CAP compile and a backend smoke test; deep also starts the app in a headless browser."
                                          class="evMuted sapUiSmallMarginBottom"/>
                                    <HBox alignItems="Center" wrap="Wrap">
                                        <SegmentedButton selectedKey="{draft>/validateLevel}" class="sapUiSmallMarginEnd" width="17rem">
                                            <items>
                                                <SegmentedButtonItem key="standard" text="Standard"/>
                                                <SegmentedButtonItem key="deep" text="Deep (browser)"/>
                                            </items>
                                        </SegmentedButton>
                                        <Button id="btnValidate" text="{i18n>validate}" icon="sap-icon://quality-issue"
                                                type="Emphasized" press=".onValidate"
                                                enabled="{= !!${draft>/generated/version_id} &amp;&amp; !${jobs>/byKind/validate} }"/>
                                    </HBox>
                                    <VBox binding="{jobs>/byKind/validate}">
                                        <core:Fragment fragmentName="com.evoke.studio.fragment.JobPanel" type="XML"/>
                                    </VBox>
                                    <VBox visible="{= !!${draft>/validation} }" class="sapUiSmallMarginTop">
                                        <MessageStrip type="{= ${draft>/validation/blocking} &amp;&amp; ${draft>/validation/blocking}.length ? 'Error' : 'Success' }"
                                                      showIcon="true" class="sapUiSmallMarginBottom"
                                                      text="{path: 'draft>/validation/blocking', formatter: '.fmt.blockingText'}"/>
                                        <HBox wrap="Wrap" class="sapUiSmallMarginBottom">
                                            <ObjectStatus text="{= ${draft>/validation/summary/passed} + ' passed' }" state="Success" inverted="true" class="sapUiSmallMarginEnd"/>
                                            <ObjectStatus text="{= ${draft>/validation/summary/failed} + ' failed' }" state="{= ${draft>/validation/summary/failed} ? 'Error' : 'None' }" inverted="true" class="sapUiSmallMarginEnd"/>
                                            <ObjectStatus text="{= ${draft>/validation/summary/warnings} + ' warning(s)' }" state="{= ${draft>/validation/summary/warnings} ? 'Warning' : 'None' }" inverted="true" class="sapUiSmallMarginEnd"/>
                                            <ObjectStatus text="{= ${draft>/validation/summary/not_tested} + ' not tested' }" state="None" inverted="true"/>
                                        </HBox>
                                        <IconTabBar expandable="false" headerMode="Inline" applyContentPadding="false" class="evInnerTabs">
                                            <items>
                                                <IconTabFilter text="{parts: ['i18n>checks', 'draft>/validation/checks'], formatter: '.fmt.titleCount'}" key="checks">
                                                    <Table items="{draft>/validation/checks}">
                                                        <columns>
                                                            <Column width="8rem"><Text text="Status"/></Column>
                                                            <Column><Text text="Check"/></Column>
                                                            <Column minScreenWidth="Tablet" demandPopin="true" width="7rem"><Text text="Area"/></Column>
                                                            <Column minScreenWidth="Desktop" demandPopin="true"><Text text="Detail"/></Column>
                                                        </columns>
                                                        <items>
                                                            <ColumnListItem>
                                                                <cells>
                                                                    <ObjectStatus text="{path: 'draft>status', formatter: '.fmt.statusText'}"
                                                                                  state="{path: 'draft>status', formatter: '.fmt.statusState'}"/>
                                                                    <ObjectIdentifier title="{draft>name}" text="{= ${draft>critical} ? 'critical' : '' }"/>
                                                                    <Text text="{draft>category}"/>
                                                                    <Text text="{= ${draft>status} === 'passed' ? '' : ${draft>detail} }" maxLines="4" class="evMuted"/>
                                                                </cells>
                                                            </ColumnListItem>
                                                        </items>
                                                    </Table>
                                                </IconTabFilter>
                                                <IconTabFilter text="{parts: ['i18n>requirements', 'draft>/validation/requirements'], formatter: '.fmt.titleCount'}" key="reqs">
                                                    <Table items="{draft>/validation/requirements}" noDataText="No requirement coverage (the AI analysis was not run).">
                                                        <columns>
                                                            <Column width="8rem"><Text text="Status"/></Column>
                                                            <Column><Text text="Requirement"/></Column>
                                                            <Column minScreenWidth="Tablet" demandPopin="true"><Text text="Detail"/></Column>
                                                        </columns>
                                                        <items>
                                                            <ColumnListItem>
                                                                <cells>
                                                                    <ObjectStatus text="{path: 'draft>status', formatter: '.fmt.statusText'}"
                                                                                  state="{path: 'draft>status', formatter: '.fmt.statusState'}"/>
                                                                    <Text text="{draft>feature}"/>
                                                                    <Text text="{draft>detail}" class="evMuted" maxLines="3"/>
                                                                </cells>
                                                            </ColumnListItem>
                                                        </items>
                                                    </Table>
                                                </IconTabFilter>
                                            </items>
                                        </IconTabBar>
                                    </VBox>
                                </Panel>
                            </VBox>
                        </VBox>
                    </IconTabFilter>
                </items>
            </IconTabBar>
        </f:content>
        <f:footer>
            <OverflowToolbar>
                <Button text="{i18n>back}" icon="sap-icon://nav-back" press=".onPrev"
                        visible="{= ${draft>/step} !== 'describe' }"/>
                <ToolbarSpacer/>
                <Button text="{= ${draft>/step} === 'describe' ? 'Data model' : ${draft>/step} === 'model' ? 'Screens' : ${draft>/step} === 'design' ? 'Try it' : 'Generate' }"
                        icon="sap-icon://navigation-right-arrow" iconFirst="false" type="Emphasized" press=".onNext"
                        visible="{= ${draft>/step} !== 'generate' }"
                        enabled="{= ${draft>/step} === 'describe' ? !!${draft>/domain} : ${draft>/step} === 'model' ? !!${draft>/domain} : !!${draft>/design} }"/>
            </OverflowToolbar>
        </f:footer>
    </f:DynamicPage>
</mvc:View>
